# VEXORA Server Configuration (never commit a real .env file or place secrets in .env.example)

# HTTP port and runtime mode (optional in local/preview; defaults to 3000 and development)
PORT=3000
NODE_ENV=development

# Public URL where this app is served (automatically injected in AI Studio / Cloud Run)
APP_URL=http://localhost:3000

# Optional comma-separated list of explicit trusted browser origins for credentialed requests
# Do NOT use "*" wildcards; list exact origins only (e.g. https://vexora.example.com)
ALLOWED_ORIGINS=

# FFmpeg & FFprobe executable commands (uses system PATH by default)
# Override with full binary paths only if ffmpeg/ffprobe are outside system PATH
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Media size limit in MB and optional directories for temporary job/history storage
# Leave directories empty to use the OS temporary directory safely in development/preview
VEXORA_MAX_MEDIA_MB=500
VEXORA_JOBS_DIR=
VEXORA_DATA_DIR=

# Optional comma-separated allowlist of permitted media hostnames (empty = allow verified public hosts)
VEXORA_ALLOWED_HOSTS=

# API rate limit (requests per minute per IP)
VEXORA_RATE_LIMIT_MAX=300

# Optional public backend base URL (leave empty when frontend and backend share the same origin, e.g. Render Web Service)
# Set at build time only if hosting frontend separately from the backend API
VITE_API_BASE_URL=

# Note: Production deployments should also configure VEXORA_SESSION_SECRET in your host's
# secret manager (Render Blueprint sets generateValue: true automatically; see ENVIRONMENT_SETUP.md).
